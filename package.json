{
  "name": "gms-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:sources": "tsx db/seed-sources.ts",
    "db:seed:content": "tsx db/seed-content.ts",
    "db:seed": "npm run db:seed:sources && npm run db:seed:content && npm run db:seed:lessons && npm run db:seed:assignments && npm run db:match && npm run db:seed:evals",
    "db:reset": "node -e \"require('fs').rmSync('./.pglite',{recursive:true,force:true});console.log('local database reset')\"",
    "screenshot": "tsx scripts/screenshot.ts",
    "db:seed:lessons": "tsx db/seed-lessons.ts",
    "verify:lesson": "tsx scripts/verify-lesson.ts",
    "verify:vocab": "tsx scripts/verify-vocab.ts",
    "verify:matching": "tsx scripts/verify-matching.ts",
    "db:seed:assignments": "tsx db/seed-assignments.ts",
    "db:match": "tsx db/compute-matches.ts",
    "verify:assignments": "tsx scripts/verify-assignments.ts",
    "verify:dashboard": "tsx scripts/verify-dashboard.ts",
    "verify:all": "npm run verify:pipeline && npm run verify:eval && npm run verify:matching && npm run verify:lesson && npm run verify:vocab && npm run verify:assignments && npm run verify:dashboard",
    "collect": "tsx pipeline/run.ts",
    "collect:dry": "tsx pipeline/run.ts --dry-run --limit 2",
    "db:fix": "npm run db:reset && npm run db:migrate && npm run db:seed",
    "probe:feeds": "tsx scripts/probe-feeds.ts",
    "collect:one": "tsx pipeline/run.ts --limit 1 --total 1",
    "verify:pipeline": "tsx scripts/verify-pipeline.ts",
    "icons": "tsx scripts/make-icons.ts",
    "db:seed:evals": "tsx db/seed-evals.ts",
    "eval": "tsx pipeline/eval.ts",
    "verify:eval": "tsx scripts/verify-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electric-sql/pglite": "^0.5.8",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
